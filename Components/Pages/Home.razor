@page "/"
@using Microsoft.AspNetCore.Components.Authorization;
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations;
@using System.IO;
<PageTitle>Home</PageTitle>

<h1>Welcome to the ledger app!</h1>

<AuthorizeView>
    <Authorized Context="auth">
        <h2>Hello, <strong>@auth.User.Identity?.Name</strong>!</h2>
        
    <EditForm Model="@invoiceDto" OnValidSubmit="HandleValidSubmit" FormName="uploadInvoice">
        <AntiforgeryToken />
        <DataAnnotationsValidator /> 


        <ValidationSummary />
        @if (string.IsNullOrEmpty(errorMessage) && success) {
            <div class="alert alert-secondary" role="alert">
             Successfully registered invoice
            </div>
        }

        <div class="mb-3">
            <label for="name" class="form-label">Name of the invoice</label>
            <input type="text" class="form-control" id="name" placeholder="name of the invoice" @bind-value="invoiceDto.Name">
            <ValidationMessage For="@(() => invoiceDto.Name)" class="text-danger" />
        </div>
            <div class="form-check mb-3">
                <InputFile id="invoiceFile" accept=".pdf,.png,.jpg,.jpeg" />
        </div>
        <div class="form-check mb-3">
            <input type="checkbox" class="form-check-input" id="shouldSendEmail" @bind-value="invoiceDto.sendEmail" >
            <label for="shouldSendEmail">Should send email?</label>
        </div>

        <div class="form-check mb-3">
            <input type="checkbox" class="form-check-input" id="shouldSendSms" @bind-value="invoiceDto.sendSMS">
            <label for="shouldSendSms">Should send sms?</label>
        </div>
        <div class="mb-3">
            <label for="notify" class="form-label">Notify me - how many days before?</label>
            <input type="range" class="form-range" id="notify" min="1" max="15" step="1" @bind-value="invoiceDto.notifyDaysBefore">
            <output for="notify" id="notifyValue">@invoiceDto.notifyDaysBefore</output>
        </div>

        <div class="mb-3">
            <label for="paidAt">PaidAt date</label>
            <input id="paidAt" class="form-control" type="date" @bind-value="invoiceDto.PaidAt"/>
        </div>
        
        <button class="btn btn-primary" type="submit" value="Submit" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span>Saving...</span>
                } else
                {
                    <span>Save invoice</span>
                }
        </button>

    </EditForm>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3">@errorMessage</div>
        }
    </Authorized>
    <NotAuthorized>
        <p>You are not logged in.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private InvoiceDto invoiceDto = new()
    {
        notifyDaysBefore = 1
    };
    private bool isSubmitting = false;

    private bool success = false;
    private string? errorMessage;

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            invoiceDto.CreatedAt = DateOnly.FromDateTime(DateTime.UtcNow);
            var result = await JS.InvokeAsync<UploadResult>("uploadInvoice", new
            {
                name = invoiceDto.Name,
                notifyDaysBefore = invoiceDto.notifyDaysBefore,
                sendEmail = invoiceDto.sendEmail,
                sendSMS = invoiceDto.sendSMS,
                paidAt = invoiceDto.PaidAt.ToString("yyyy-MM-dd"),
                createdAt = invoiceDto.CreatedAt.ToString("yyyy-MM-dd")
            });

            if (result.Ok)
            {
                success = true;
                return;
            }

            errorMessage = $"Server error ({result.Status}): {result.Body}";
        } catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        } finally {
            isSubmitting = false;
        }
    }

    private sealed class UploadResult
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string Body { get; set; } = string.Empty;
    }

}

